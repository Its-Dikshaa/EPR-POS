datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_STAFF
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  MIXED
  CREDIT
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum DiscountType {
  BILL_DISCOUNT
  ITEM_DISCOUNT
}

enum ValueType {
  PERCENTAGE
  FLAT_AMOUNT
}

model StoreBranch {
  id           String      @id @default(uuid())
  name         String
  location     String
  manager      String?
  phone        String?
  email        String?
  gst          String?
  openTime     String?
  closeTime    String?
  status       String      @default("Active")
  salesTotal   Float       @default(0)
  staffCount   Int         @default(0)
  isFranchise  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users        User[]
  inventories  Inventory[]
  sales        Sale[]
  purchases    PurchaseOrder[]
  expenses     Expense[]
  posTerminals PosTerminal[]
}

model User {
  id            String       @id @default(uuid())
  name          String
  username      String       @unique
  email         String?      @unique
  password      String?
  role          Role         @default(CASHIER)
  status        String       @default("Active")
  lastLogin     DateTime?
  storeBranchId String?
  storeBranch   StoreBranch? @relation(fields: [storeBranchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sales         Sale[]
  cashSessions  CashSession[]
  employees     Employee[]
}

model RolePermission {
  id         String   @id @default(uuid())
  role       Role
  permission String
  createdAt  DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model GstTaxSlab {
  id          String    @id @default(uuid())
  hsnCode     String    @unique
  description String?
  gstRate     Float
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String       @id @default(uuid())
  name          String
  sku           String       @unique
  categoryName  String
  brandName     String?
  mrp           Float
  salePrice     Float
  purchasePrice Float
  gstRate       Float        @default(5)
  hsnCode       String?
  unit          String       @default("Pack")
  barcode       String?      @unique
  rackPosition  String?
  status        String       @default("Active")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category      Category?    @relation(fields: [categoryName], references: [name])
  brand         Brand?       @relation(fields: [brandName], references: [name])
  gstSlab       GstTaxSlab?  @relation(fields: [hsnCode], references: [hsnCode])
  inventories   Inventory[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]
}

model Inventory {
  id            String       @id @default(uuid())
  productId     String
  storeBranchId String
  stockQuantity Int          @default(0)
  reorderLevel  Int          @default(10)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product       Product      @relation(fields: [productId], references: [id])
  storeBranch   StoreBranch  @relation(fields: [storeBranchId], references: [id])

  @@unique([productId, storeBranchId])
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  type          StockMovementType
  quantity      Int
  reason        String?
  referenceId   String?
  createdAt     DateTime          @default(now())

  product       Product           @relation(fields: [productId], references: [id])
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  creditLimit   Float    @default(5000)
  outstanding   Float    @default(0)
  group         String   @default("Regular")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales         Sale[]
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contact     String?
  phone       String?
  gst         String?
  address     String?
  outstanding Float    @default(0)
  creditDays  Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   PurchaseOrder[]
}

model Sale {
  id            String        @id @default(uuid())
  billNo        String        @unique
  date          DateTime      @default(now())
  customerId    String?
  customerName  String        @default("Walk-in")
  customerPhone String?
  cashierId     String?
  cashierName   String?
  storeBranchId String?
  subtotal      Float
  gstAmount     Float
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  cashPaid      Float?
  changeReturn  Float?
  createdAt     DateTime      @default(now())

  customer      Customer?     @relation(fields: [customerId], references: [id])
  cashier       User?         @relation(fields: [cashierId], references: [id])
  storeBranch   StoreBranch?  @relation(fields: [storeBranchId], references: [id])
  saleItems     SaleItem[]
  payments      Payment[]
  returns       Return[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  name      String
  quantity  Int
  price     Float
  gstRate   Float    @default(0)
  total     Float

  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Float
  transactionId String?
  createdAt     DateTime      @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id])
}

model PurchaseOrder {
  id            String         @id @default(uuid())
  poNumber      String         @unique
  supplierId    String?
  supplierName  String
  storeBranchId String?
  totalAmount   Float
  status        PurchaseStatus @default(PENDING)
  orderDate     DateTime       @default(now())

  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  storeBranch   StoreBranch?   @relation(fields: [storeBranchId], references: [id])
  items         PurchaseItem[]
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  costPrice       Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model Return {
  id        String   @id @default(uuid())
  saleId    String
  reason    String
  refundAmt Float
  createdAt DateTime @default(now())

  sale      Sale     @relation(fields: [saleId], references: [id])
}

model Expense {
  id            String       @id @default(uuid())
  category      String
  amount        Float
  description   String?
  paidBy        String?
  status        String       @default("Approved")
  date          DateTime     @default(now())
  storeBranchId String?

  storeBranch   StoreBranch? @relation(fields: [storeBranchId], references: [id])
}

model Employee {
  id        String   @id @default(uuid())
  userId    String?  @unique
  name      String
  role      String
  phone     String?
  salary    Float?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model PosTerminal {
  id            String       @id @default(uuid())
  terminalCode  String       @unique
  storeBranchId String
  status        String       @default("Active")
  createdAt     DateTime     @default(now())

  storeBranch   StoreBranch  @relation(fields: [storeBranchId], references: [id])
  cashSessions  CashSession[]
}

model CashSession {
  id            String       @id @default(uuid())
  posTerminalId String
  userId        String
  openingCash   Float
  closingCash   Float?
  status        String       @default("Open")
  startTime     DateTime     @default(now())
  endTime       DateTime?

  posTerminal   PosTerminal  @relation(fields: [posTerminalId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

model Discount {
  id                 String       @id @default(uuid())
  name               String
  code               String       @unique
  type               DiscountType @default(BILL_DISCOUNT)
  valType            ValueType    @default(PERCENTAGE)
  value              Float
  validity           DateTime
  status             String       @default("Active")
  applicableProducts String[]
  createdAt          DateTime     @default(now())
}
