# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/kc_pos_db?schema=public"

# Auth.js / NextAuth Secrets
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary / S3 Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Supabase / Realtime Keys (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
